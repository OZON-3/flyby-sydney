{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyby-sydney.local/ambience/schema/areas.schema.json",
  "type": "object",
  "properties": {
    "feed": {
      "const": "areas",
      "description": "Always \"areas\" in this file."
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Contract version. The game reads the versions in config feeds[feed].versions. Additive fields do not bump it; renames, unit changes and removals do."
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^(\\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):([0-5]\\d)(?::([0-5]\\d)(?:\\.(\\d+))?)?(Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "format": "date-time",
      "description": "When the backend wrote the file."
    },
    "validUntil": {
      "type": "string",
      "pattern": "^(\\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):([0-5]\\d)(?::([0-5]\\d)(?:\\.(\\d+))?)?(Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "format": "date-time",
      "description": "After this a live feed counts as stale: in live mode its values ease to neutral. Required on live feeds in live data; optional on static tables."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "\"sample\", or the backend’s own label (e.g. \"db:weather/v2\"). Audit only; never shown."
    },
    "sample": {
      "type": "boolean",
      "description": "True for hand-made data. Live mode refuses a file marked sample unless it is a preset table (config feeds[f].defaultInLive) (decision 4)."
    },
    "bundleRevision": {
      "type": "integer",
      "minimum": 0,
      "description": "The publication this file belongs to; must equal the manifest’s."
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
            "description": "Stable key. Fades, audio voices, dissolve seeds and per-device memory key on it. Unique within the feed."
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "description": "Whole number that rises whenever the row changes (diffing, cache-busting, precedence ties)."
          },
          "sample": {
            "type": "boolean",
            "description": "True for hand-made data. Must be true in every sample file; must be false in live data."
          },
          "classification": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1,
                "description": "How the preset was chosen upstream, e.g. \"weaviate-hybrid+rules\"."
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "description": "Version of that method, e.g. \"2026-12-01\"."
              },
              "confidence01": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "A calibrated classification confidence, 0–1. Only when calibrated: Weaviate distances and hybrid scores rank candidates and are not probabilities, so they stay upstream (R14). Below minConfidence01 (config) the game uses the category default."
              }
            },
            "required": [
              "method",
              "version"
            ],
            "additionalProperties": true,
            "description": "How the preset ids in this record were chosen upstream."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "maxItems": 16,
            "description": "Free labels from the backend; the game ignores them."
          },
          "rightsRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Rights note for any recorded sound or authored asset the record names (the owner's own recordings only)."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Display name only."
          },
          "where": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "circle"
                  },
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90,
                    "description": "Latitude, WGS84 degrees."
                  },
                  "lng": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180,
                    "description": "Longitude, WGS84 degrees."
                  },
                  "radiusMetres": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 60000,
                    "description": "Radius, metres."
                  },
                  "edgeMetres": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60000,
                    "description": "Blend width at the edge, metres (weights fade in over it)."
                  }
                },
                "required": [
                  "kind",
                  "lat",
                  "lng",
                  "radiusMetres"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "polygon"
                  },
                  "ring": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180,
                          "description": "Longitude, WGS84 degrees."
                        },
                        {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90,
                          "description": "Latitude, WGS84 degrees."
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "[longitude, latitude], WGS84 degrees."
                    },
                    "minItems": 4,
                    "maxItems": 256,
                    "description": "Closed ring of [lng, lat] points: the last point repeats the first."
                  },
                  "edgeMetres": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60000,
                    "description": "Blend width at the edge, metres (weights fade in over it)."
                  }
                },
                "required": [
                  "kind",
                  "ring"
                ],
                "additionalProperties": true,
                "description": "Also checked: the ring is closed (last point = first) and does not cross itself."
              }
            ],
            "description": "Geometry only: a circle or a polygon (R17)."
          },
          "kind": {
            "type": "string",
            "enum": [
              "harbour",
              "beach",
              "cbd",
              "village",
              "park",
              "suburb",
              "open-water",
              "venue"
            ],
            "description": "What sort of place."
          },
          "soundscapeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
            "x-ref": "soundscape",
            "description": "Soundscape record for the area (chosen upstream from its description)."
          },
          "moodId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
            "x-ref": "mood",
            "description": "Mood record for the area."
          },
          "activityByHour": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 24,
            "maxItems": 24,
            "description": "How busy the area is by Sydney hour 0–23, 0–1 (drives people, traffic hum, crowd beds)."
          },
          "weekdayFactor": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "minItems": 7,
            "maxItems": 7,
            "description": "Multiplier per weekday, 0 = Sunday."
          }
        },
        "required": [
          "id",
          "revision",
          "sample",
          "name",
          "where",
          "kind"
        ],
        "additionalProperties": true,
        "description": "A named place many feeds refer to (§3.0)."
      },
      "description": "The rows. A row that fails its check is skipped and counted; the rest still load."
    }
  },
  "required": [
    "feed",
    "schemaVersion",
    "generatedAt",
    "source",
    "sample",
    "bundleRevision",
    "records"
  ],
  "additionalProperties": true,
  "description": "public/ambience/areas.json"
}

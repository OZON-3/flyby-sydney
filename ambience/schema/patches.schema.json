{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyby-sydney.local/ambience/schema/patches.schema.json",
  "type": "object",
  "properties": {
    "feed": {
      "const": "patches",
      "description": "Always \"patches\" in this file."
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Contract version. The game reads the versions in config feeds[feed].versions. Additive fields do not bump it; renames, unit changes and removals do."
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^(\\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):([0-5]\\d)(?::([0-5]\\d)(?:\\.(\\d+))?)?(Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "format": "date-time",
      "description": "When the backend wrote the file."
    },
    "validUntil": {
      "type": "string",
      "pattern": "^(\\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):([0-5]\\d)(?::([0-5]\\d)(?:\\.(\\d+))?)?(Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "format": "date-time",
      "description": "After this a live feed counts as stale: in live mode its values ease to neutral. Required on live feeds in live data; optional on static tables."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "\"sample\", or the backend’s own label (e.g. \"db:weather/v2\"). Audit only; never shown."
    },
    "sample": {
      "type": "boolean",
      "description": "True for hand-made data. Live mode refuses a file marked sample unless it is a preset table (config feeds[f].defaultInLive) (decision 4)."
    },
    "bundleRevision": {
      "type": "integer",
      "minimum": 0,
      "description": "The publication this file belongs to; must equal the manifest’s."
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
            "description": "Stable key. Fades, audio voices, dissolve seeds and per-device memory key on it. Unique within the feed."
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "description": "Whole number that rises whenever the row changes (diffing, cache-busting, precedence ties)."
          },
          "sample": {
            "type": "boolean",
            "description": "True for hand-made data. Must be true in every sample file; must be false in live data."
          },
          "classification": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1,
                "description": "How the preset was chosen upstream, e.g. \"weaviate-hybrid+rules\"."
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "description": "Version of that method, e.g. \"2026-12-01\"."
              },
              "confidence01": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "A calibrated classification confidence, 0–1. Only when calibrated: Weaviate distances and hybrid scores rank candidates and are not probabilities, so they stay upstream (R14). Below minConfidence01 (config) the game uses the category default."
              }
            },
            "required": [
              "method",
              "version"
            ],
            "additionalProperties": true,
            "description": "How the preset ids in this record were chosen upstream."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "maxItems": 16,
            "description": "Free labels from the backend; the game ignores them."
          },
          "rightsRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Rights note for any recorded sound or authored asset the record names (the owner's own recordings only)."
          },
          "bus": {
            "type": "string",
            "enum": [
              "engine",
              "wind",
              "ambience",
              "event",
              "ui"
            ],
            "description": "Mix bus. Effects level: engine, wind, ui; Ambience: ambience; Events: event."
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "src": {
                  "type": "string",
                  "enum": [
                    "noise-white",
                    "noise-pink",
                    "noise-brown",
                    "osc-sine",
                    "osc-saw",
                    "osc-square",
                    "osc-tri",
                    "sample"
                  ],
                  "description": "Sound source. 'sample' plays only the owner's own recording (decision 11: not used yet)."
                },
                "freqHz": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 20000,
                  "description": "Oscillator frequency, Hz (oscillators only; required for them)."
                },
                "detuneCents": {
                  "type": "number",
                  "minimum": -2400,
                  "maximum": 2400,
                  "description": "Detune, cents."
                },
                "filter": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "lowpass",
                        "bandpass",
                        "highpass"
                      ],
                      "description": "Filter type."
                    },
                    "freqHz": {
                      "type": "number",
                      "minimum": 10,
                      "maximum": 20000,
                      "description": "Cutoff or centre, Hz."
                    },
                    "q": {
                      "type": "number",
                      "minimum": 0.0001,
                      "maximum": 30,
                      "description": "Filter Q."
                    }
                  },
                  "required": [
                    "type",
                    "freqHz",
                    "q"
                  ],
                  "additionalProperties": true,
                  "description": "A filter on this layer alone."
                },
                "gain01": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Layer level, 0–1."
                },
                "decaySec": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 10,
                  "description": "One-shots only: this layer dies away over this after the attack (a knock or click on a thump, so phone speakers hear it), seconds. Absent = it follows the envelope."
                },
                "file": {
                  "type": "string",
                  "pattern": "^(?!\\/)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,200}$",
                  "description": "'sample' only: path under public/audio/, the owner's own recording (needs rightsRef on the record)."
                }
              },
              "required": [
                "src",
                "gain01"
              ],
              "additionalProperties": true,
              "description": "Also checked: oscillators have freqHz; 'sample' has file; file only with 'sample'."
            },
            "minItems": 1,
            "maxItems": 4,
            "description": "Sound layers; each is one source node while it plays."
          },
          "envelope": {
            "type": "object",
            "properties": {
              "attackSec": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Rise from silence to full, seconds."
              },
              "holdSec": {
                "type": "number",
                "minimum": 0,
                "maximum": 30,
                "description": "Time held at full, seconds."
              },
              "releaseSec": {
                "type": "number",
                "minimum": 0,
                "maximum": 30,
                "description": "Fall back to silence, seconds."
              }
            },
            "required": [
              "attackSec",
              "holdSec",
              "releaseSec"
            ],
            "additionalProperties": true,
            "description": "One-shot envelope, seconds. Absent = a loop."
          },
          "pitchGlide": {
            "type": "object",
            "properties": {
              "fromRatio": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10,
                "description": "Pitch at the start, as a ratio of the patch pitch."
              },
              "toRatio": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10,
                "description": "Pitch at the end, as a ratio."
              },
              "sec": {
                "type": "number",
                "minimum": 0,
                "maximum": 30,
                "description": "Glide length, seconds."
              }
            },
            "required": [
              "fromRatio",
              "toRatio",
              "sec"
            ],
            "additionalProperties": true,
            "description": "Pitch glide from one ratio to another over sec."
          },
          "amMod": {
            "type": "object",
            "properties": {
              "rateHz": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 200,
                "description": "Tremolo rate, Hz."
              },
              "depth01": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Tremolo depth, 0–1 (1 = full on/off)."
              }
            },
            "required": [
              "rateHz",
              "depth01"
            ],
            "additionalProperties": true,
            "description": "Amplitude modulation (tremolo); its oscillator counts as a source."
          },
          "randomise": {
            "type": "object",
            "properties": {
              "pitchCents": {
                "type": "number",
                "minimum": 0,
                "maximum": 1200,
                "description": "± random pitch per play, cents."
              },
              "gainDb": {
                "type": "number",
                "minimum": 0,
                "maximum": 24,
                "description": "± random level per play, decibels."
              },
              "intervalSec": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3600
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3600
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2,
                "description": "Random gap between repeats, [min, max] seconds. Also checked: the first value is not above the second."
              }
            },
            "required": [
              "pitchCents",
              "gainDb"
            ],
            "additionalProperties": true,
            "description": "Variation per play."
          }
        },
        "required": [
          "id",
          "revision",
          "sample",
          "bus",
          "layers"
        ],
        "additionalProperties": true,
        "description": "A synthesised sound (§2.5). The game binds live parameters (speed, throttle, rpm) in code; data may retune a patch but cannot add a binding. Also checked: a 'sample' layer needs rightsRef."
      },
      "description": "The rows. A row that fails its check is skipped and counted; the rest still load."
    }
  },
  "required": [
    "feed",
    "schemaVersion",
    "generatedAt",
    "source",
    "sample",
    "bundleRevision",
    "records"
  ],
  "additionalProperties": true,
  "description": "public/ambience/patches.json"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyby-sydney.local/ambience/schema/rides.schema.json",
  "type": "object",
  "properties": {
    "feed": {
      "const": "rides",
      "description": "Always \"rides\" in this file."
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Contract version. The game reads the versions in config feeds[feed].versions. Additive fields do not bump it; renames, unit changes and removals do."
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^(\\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):([0-5]\\d)(?::([0-5]\\d)(?:\\.(\\d+))?)?(Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "format": "date-time",
      "description": "When the backend wrote the file."
    },
    "validUntil": {
      "type": "string",
      "pattern": "^(\\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):([0-5]\\d)(?::([0-5]\\d)(?:\\.(\\d+))?)?(Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "format": "date-time",
      "description": "After this a live feed counts as stale: in live mode its values ease to neutral. Required on live feeds in live data; optional on static tables."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "\"sample\", or the backend’s own label (e.g. \"db:weather/v2\"). Audit only; never shown."
    },
    "sample": {
      "type": "boolean",
      "description": "True for hand-made data. Live mode refuses a file marked sample unless it is a preset table (config feeds[f].defaultInLive) (decision 4)."
    },
    "bundleRevision": {
      "type": "integer",
      "minimum": 0,
      "description": "The publication this file belongs to; must equal the manifest’s."
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
            "description": "Stable key. Fades, audio voices, dissolve seeds and per-device memory key on it. Unique within the feed."
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "description": "Whole number that rises whenever the row changes (diffing, cache-busting, precedence ties)."
          },
          "sample": {
            "type": "boolean",
            "description": "True for hand-made data. Must be true in every sample file; must be false in live data."
          },
          "classification": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1,
                "description": "How the preset was chosen upstream, e.g. \"weaviate-hybrid+rules\"."
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "description": "Version of that method, e.g. \"2026-12-01\"."
              },
              "confidence01": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "A calibrated classification confidence, 0–1. Only when calibrated: Weaviate distances and hybrid scores rank candidates and are not probabilities, so they stay upstream (R14). Below minConfidence01 (config) the game uses the category default."
              }
            },
            "required": [
              "method",
              "version"
            ],
            "additionalProperties": true,
            "description": "How the preset ids in this record were chosen upstream."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "maxItems": 16,
            "description": "Free labels from the backend; the game ignores them."
          },
          "rightsRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Rights note for any recorded sound or authored asset the record names (the owner's own recordings only)."
          },
          "rideId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
            "description": "Part id the landmark builder declares."
          },
          "motionProfileId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
            "x-ref": "preset:motion",
            "description": "Approved motion (config)."
          },
          "cycleSec": {
            "type": "number",
            "minimum": 1,
            "maximum": 3600,
            "description": "One ride cycle, seconds."
          },
          "dwellSec": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600,
            "description": "Stopped between cycles (loading), seconds."
          },
          "phaseOffsetSec": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600,
            "description": "Shift of this ride’s cycle, seconds (rides do not move in step)."
          },
          "rpm": {
            "type": "number",
            "minimum": 0,
            "maximum": 30,
            "description": "Turns per minute while running."
          },
          "running": {
            "type": "boolean",
            "description": "The ride's switch (the park's open or closed status): false stands it at its loading pose, after it finishes the ride under way. The ride runs while this is true and its `when` is open."
          },
          "when": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "always"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "span"
                  },
                  "startAt": {
                    "type": "string",
                    "pattern": "^(\\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):([0-5]\\d)(?::([0-5]\\d)(?:\\.(\\d+))?)?(Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
                    "format": "date-time",
                    "description": "Start instant, ISO 8601 with offset."
                  },
                  "endAt": {
                    "type": "string",
                    "pattern": "^(\\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):([0-5]\\d)(?::([0-5]\\d)(?:\\.(\\d+))?)?(Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
                    "format": "date-time",
                    "description": "End instant, ISO 8601 with offset; after startAt."
                  }
                },
                "required": [
                  "kind",
                  "startAt",
                  "endAt"
                ],
                "additionalProperties": true,
                "description": "Also checked: endAt is after startAt."
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "weekly"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "description": "Opens at, Sydney time."
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "description": "Closes at, Sydney time. At or before `from` it passes midnight; the window belongs to the weekday it starts on (Sat 22:00–02:00 is Saturday’s). Equal to `from` = 24 hours."
                  },
                  "weekdays": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    },
                    "minItems": 1,
                    "maxItems": 7,
                    "description": "Start weekdays, 0 = Sunday … 6 = Saturday. Absent = every day."
                  },
                  "months": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 12
                    },
                    "minItems": 1,
                    "maxItems": 12,
                    "description": "Start months 1–12. Absent = all year."
                  },
                  "dateFrom": {
                    "type": "string",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
                    "format": "date",
                    "description": "First start date, Sydney \"YYYY-MM-DD\"."
                  },
                  "dateTo": {
                    "type": "string",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
                    "format": "date",
                    "description": "Last start date, Sydney \"YYYY-MM-DD\"."
                  }
                },
                "required": [
                  "kind",
                  "from",
                  "to"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "sun"
                  },
                  "anchor": {
                    "type": "string",
                    "enum": [
                      "sunrise",
                      "sunset",
                      "civilDawn",
                      "civilDusk"
                    ],
                    "description": "The real sun event for the Sydney date (SKY1)."
                  },
                  "offsetMin": {
                    "type": "number",
                    "minimum": -720,
                    "maximum": 720,
                    "description": "Start, minutes after the anchor (negative = before)."
                  },
                  "durationMin": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 1440,
                    "description": "Length, real elapsed minutes."
                  },
                  "months": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 12
                    },
                    "minItems": 1,
                    "maxItems": 12,
                    "description": "Months 1–12. Absent = all year."
                  }
                },
                "required": [
                  "kind",
                  "anchor",
                  "offsetMin",
                  "durationMin"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "lamps"
                  },
                  "onShare": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "On while at least this share of the city's lamps is on (0–1; lamps follow sun elevation)."
                  },
                  "offAt": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "description": "Switch-off, Sydney time. Before 12:00 it is the next morning; from 12:00 the same evening."
                  }
                },
                "required": [
                  "kind",
                  "onShare"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "sim"
                  },
                  "periodSec": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 86400,
                    "description": "Repeats every this many seconds of game time."
                  },
                  "durationSec": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 86400,
                    "description": "On for this long each period, seconds."
                  },
                  "offsetSec": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 86400,
                    "description": "First start, seconds of game time."
                  }
                },
                "required": [
                  "kind",
                  "periodSec",
                  "durationSec",
                  "offsetSec"
                ],
                "additionalProperties": true
              }
            ],
            "description": "When a record is active. Wall-clock forms are Sydney local time (Australia/Sydney). 'sim' is a demo timer on the game clock, allowed only in sample records and never shown as a real listing."
          }
        },
        "required": [
          "id",
          "revision",
          "sample",
          "rideId",
          "motionProfileId",
          "cycleSec",
          "dwellSec",
          "phaseOffsetSec",
          "running",
          "when"
        ],
        "additionalProperties": true,
        "description": "A moving Luna Park ride (PLN4). The rides are base content, priced by their own cost gate: they do not wait for PLN4's governor tier (src/landmarks/luna-rides/)."
      },
      "description": "The rows. A row that fails its check is skipped and counted; the rest still load."
    }
  },
  "required": [
    "feed",
    "schemaVersion",
    "generatedAt",
    "source",
    "sample",
    "bundleRevision",
    "records"
  ],
  "additionalProperties": true,
  "description": "public/ambience/rides.json"
}
